{
  "include": ["worker/**/*.ts", ".cloudflare/types/index.d.ts"],
  "exclude": ["worker/**/*.test.ts"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",

    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": [],
    "strict": true,
    "skipLibCheck": true
  }
}
