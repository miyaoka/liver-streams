{
  "name": "liver-streams",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @liver-streams/web preview",
    "check:types": "pnpm --filter @liver-streams/web exec cf workers types && bun check -b",
    "check:lint": "bun lint --type-aware --changed=${CHECK_BASE:-$(git merge-base HEAD origin/main)}",
    "check:fmt": "bun fmt --check --changed=${CHECK_BASE:-$(git merge-base HEAD origin/main)}",
    "check:test": "bun test --pass-with-no-tests --changed=${CHECK_BASE:-$(git merge-base HEAD origin/main)}",
    "fix": "bun lint --type-aware --fix --changed=${CHECK_BASE:-$(git merge-base HEAD origin/main)} && bun fmt --changed=${CHECK_BASE:-$(git merge-base HEAD origin/main)}",
    "fix:staged": "bun lint --type-aware --fix --staged && bun fmt --staged",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@miyaoka/eslint-plugin-barrel-import": "0.1.0",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "eslint-plugin-vue": "10.11.1",
    "knip": "6.41.0",
    "lefthook": "2.2.1"
  }
}
