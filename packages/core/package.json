{
  "name": "@liver-streams/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "vite build",
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "bun test",
    "typecheck": "bun check --no-script",
    "lint": "bun lint --no-script --type-aware .",
    "fix": "bun lint --no-script --type-aware --fix . && bun fmt --no-script ."
  },
  "devDependencies": {
    "@tsconfig/node24": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:"
  }
}
